# =============================================
# Application
# =============================================
CORS_ORIGIN=http://localhost:5173
# В проде за HTTPS/TLS-прокси поставить true (Secure-флаг на session-cookie).
# В dev по HTTP оставить false, иначе браузер не отдаст cookie.
SESSION_COOKIE_SECURE=false

# =============================================
# Прод / TLS (нужны только для docker-compose.prod.yml)
# =============================================
# Домен, на котором крутится прод. Подставляется в конфиг nginx и в пути к
# сертификатам Let's Encrypt. В dev не используется.
DOMAIN=akitastudio.example.com
# Поддомен для медиа из MinIO (портфолио, фото заказов, PDF политики).
# Нужен именно отдельный домен: подпись SigV4 привязана к хосту и пути, префикс
# на основном домене сломал бы приватные ссылки. DNS обоих доменов -> этот сервер.
MEDIA_DOMAIN=media.akitastudio.example.com
# Почта для Let's Encrypt: туда придёт письмо, если сертификат не продлится.
CERTBOT_EMAIL=admin@example.com

# Прод-чеклист (значения выше по файлу тоже надо поменять!):
#   SESSION_COOKIE_SECURE=true
#   CORS_ORIGIN=https://<домен>
#   VITE_API_URL=https://<домен>/api            # вшивается в бандл на сборке!
#   MINIO_PUBLIC_URL=https://<медиа-поддомен>   # НЕ localhost, иначе медиа не откроется
#
# ⚠️  MINIO_PUBLIC_URL менять только до первых загрузок. Он вшивается в
#     order_photos.photo_url / portfolio.video_url при заливке, а MinioHelper::parseUrl
#     сверяет сохранённый URL с ТЕКУЩИМ значением. Поменяешь позже — старые ссылки
#     перестанут разбираться. Проверить, что уже лежит в БД:
#       SELECT DISTINCT split_part(photo_url, '/', 3) FROM order_photos;
#     Мигрировать при смене:
#       UPDATE order_photos SET photo_url = replace(photo_url, '<старый>', '<новый>');
#
# Порядок: заполнить .env -> make tls-init DRY_RUN=1 -> make tls-init -> make prod

# =============================================
# Database (локальный запуск без Docker)
# В Docker значения DB_HOST и DB_PORT
# переопределяются прямо в docker-compose.yml
# =============================================
DB_HOST=localhost
DB_PORT=5433
DB_NAME=AkitaStudio
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# =============================================
# DaData
# =============================================
DADATA_TOKEN=your_dadata_token_here
DADATA_SECRET=your_dadata_secret_here

# =============================================
# MinIO (объектное хранилище)
# В Docker MINIO_ENDPOINT переопределяется на 'minio' (см. docker-compose.yml)
# =============================================
MINIO_ROOT_USER=akita_admin
MINIO_ROOT_PASSWORD=change_me_in_production
# MINIO_ACCESS_KEY и MINIO_SECRET_KEY используются PHP SDK.
# Если не заданы — SDK автоматически использует MINIO_ROOT_USER/MINIO_ROOT_PASSWORD.
# Задайте явно, если используете отдельного MinIO-пользователя.
MINIO_ACCESS_KEY=akita_admin
MINIO_SECRET_KEY=change_me_in_production
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_PUBLIC_URL=http://localhost:9000

# =============================================
# Vue / Vite (префикс VITE_ обязателен)
# =============================================
VITE_API_URL=http://localhost:8000/api

# =============================================
# Администратор (используется командой make init)
# =============================================
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me_in_production
